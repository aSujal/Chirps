@page "/login"
@using ExampleBlazor.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@inject UserService UserService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<PageTitle>Login</PageTitle>

<div class="flex min-h-screen w-full items-center justify-center bg-gray-950 px-4">

	<div class="relative w-full max-w-md">
		<div class="relative overflow-hidden rounded-2xl bg-gray-900/50 shadow-2xl">
			<div class="p-8 sm:p-10">
				<div class="mb-8 text-center">
					<h2 class="mb-2 text-3xl font-bold text-white">Welcome back</h2>
					<p class="text-gray-400">Sign in to continue to your account</p>
				</div>

				<EditForm Model="Model" OnValidSubmit="HandleLogin" FormName="LoginForm" class="space-y-6">
					<DataAnnotationsValidator />

					<div class="space-y-1">
						<label for="username" class="block text-sm font-medium text-gray-300">
							Username
						</label>
						<div class="group relative">
							<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
								<i class="fa-solid fa-user text-gray-500 transition-colors group-focus-within:text-purple-400"></i>
							</div>
							<InputText @bind-Value="Model.Username"
									   id="username"
									   class="w-full rounded-lg border border-gray-700 bg-gray-800 py-3 pl-10 pr-3 text-white placeholder-gray-500 transition-all duration-200 hover:border-gray-600 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
									   placeholder="Enter your username" />
						</div>
						<ValidationMessage For="() => Model.Username" class="mt-1 text-sm text-red-400" />
					</div>

					<div class="space-y-1">
						<label for="password" class="block text-sm font-medium text-gray-300">
							Password
						</label>
						<div class="group relative">
							<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
								<i class="fa-solid fa-lock text-gray-500 transition-colors group-focus-within:text-purple-400"></i>
							</div>
							<InputText @bind-Value="Model.Password"
									   type="@(showPassword ? "text" : "password")"
									   id="password"
									   class="w-full rounded-lg border border-gray-700 bg-gray-800 py-3 pl-10 pr-10 text-white placeholder-gray-500 transition-all duration-200 hover:border-gray-600 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
									   placeholder="Enter your password" />
							<button type="button"
									@onclick="TogglePasswordVisibility"
									class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 transition-colors hover:text-gray-300">
								<i class="fa-solid @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
							</button>
						</div>
						<ValidationMessage For="() => Model.Password" class="mt-1 text-sm text-red-400" />
					</div>

					@if (!string.IsNullOrEmpty(errorMessage))
					{
						<div class="flex items-center rounded-lg border border-red-800 bg-red-900/20 px-4 py-3 text-sm text-red-400">
							<i class="fa-solid fa-exclamation-circle mr-2"></i>
							@errorMessage
						</div>
					}

					<button type="submit"
							disabled="@isLoading"
							class="group relative w-full transform overflow-hidden rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 px-4 py-3 font-medium text-white transition-all duration-200 hover:scale-[1.02] hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 focus:ring-offset-gray-900 disabled:cursor-not-allowed disabled:from-gray-600 disabled:to-gray-700">
						<span class="relative flex items-center justify-center">
							@if (isLoading)
							{
								<i class="fas fa-spinner fa-spin mr-2"></i>
								<span>Signing in...</span>
							}
							else
							{
								<i class="fas fa-sign-in-alt mr-2"></i>
								<span>Sign in</span>
							}
						</span>
					</button>
				</EditForm>

				<div class="mt-8 border-t border-gray-800 pt-6">
					<p class="text-center text-sm text-gray-400">
						Don't have an account?
						<a href="/register" class="font-medium text-purple-400 transition-colors hover:text-purple-300">
							Create one
						</a>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	[SupplyParameterFromQuery] public string? Error { get; set; }
	public LoginModel Model { get; set; } = new();
	private bool isLoading = false;
	private string? errorMessage;
	private bool showPassword = false;

	public class LoginModel
	{
		[Required(ErrorMessage = "Username is required")]
		public string Username { get; set; } = "";

		[Required(ErrorMessage = "Password is required")]
		public string Password { get; set; } = "";
	}

	private void TogglePasswordVisibility()
	{
		showPassword = !showPassword;
	}

	protected override void OnInitialized()
	{
		if (!string.IsNullOrEmpty(Error))
		{
			errorMessage = Error;
		}
	}

	private async Task HandleLogin()
	{
		isLoading = true;
		errorMessage = null;

		try
		{
			// Redirect to login handler with credentials
			Navigation.NavigateTo($"/login-handler?username={Uri.EscapeDataString(Model.Username)}&password={Uri.EscapeDataString(Model.Password)}", forceLoad: true);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Login error: {ex.Message}");
			errorMessage = "An error occurred. Please try again.";
			isLoading = false;
		}
	}
}