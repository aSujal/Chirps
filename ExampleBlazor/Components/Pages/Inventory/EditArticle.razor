@* Components/Pages/Inventory/EditArticle.razor *@
@attribute [Authorize]
@page "/inventory/articles/{id:int}/edit"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ArticleService ArticleService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Edit Article</PageTitle>

<div class="p-6">
    <div class="mb-8 flex items-center">
        <a href="/inventory/articles" class="mr-4 rounded-lg bg-gray-700 p-2 text-white transition-colors hover:bg-gray-600">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="text-3xl font-bold text-white">Edit Article</h1>
    </div>

    @if (isLoading)
    {
        <div class="flex h-64 items-center justify-center">
            <i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
        </div>
    }
    else if (article == null)
    {
        <div class="flex items-center rounded-lg border border-red-700 bg-red-900 px-4 py-3 text-red-300">
            <i class="fa-solid fa-circle-exclamation mr-2"></i>
            Article not found.
        </div>
    }
    else
    {
        <div class="max-w-2xl">
            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <EditForm Model="@article" OnValidSubmit="@HandleSubmit" class="space-y-6">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="flex items-center rounded-lg border border-red-700 bg-red-900 px-4 py-3 text-red-300">
                            <i class="fa-solid fa-circle-exclamation mr-2"></i>
                            @errorMessage
                        </div>
                    }

                    <div>
                        <label for="articleNumber" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-hashtag mr-1"></i>
                            Article Number
                        </label>
                        <InputText @bind-Value="article.ArticleNumber"
                                   id="articleNumber"
                                   class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                   placeholder="Enter unique article number" />
                        <ValidationMessage For="@(() => article.ArticleNumber)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div>
                        <label for="name" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-tag mr-1"></i>
                            Article Name
                        </label>
                        <InputText @bind-Value="article.Name"
                                   id="name"
                                   class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                   placeholder="Enter article name" />
                        <ValidationMessage For="@(() => article.Name)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div>
                        <label for="description" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-align-left mr-1"></i>
                            Description
                        </label>
                        <InputTextArea @bind-Value="article.Description"
                                       id="description"
                                       rows="4"
                                       class="w-full resize-none rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                       placeholder="Enter article description (optional)" />
                        <ValidationMessage For="@(() => article.Description)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div class="flex gap-3 pt-4">
                        <button type="submit"
                                disabled="@isSubmitting"
                                class="flex items-center rounded-lg bg-purple-600 px-6 py-3 text-white transition-colors hover:bg-purple-700 disabled:bg-gray-600">
                            @if (isSubmitting)
                            {
                                <i class="fa-solid fa-spinner fa-spin mr-2"></i>
                                <span>Updating...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-floppy-disk mr-2"></i>
                                <span>Update Article</span>
                            }
                        </button>

                        <a href="/inventory/articles" class="flex items-center rounded-lg bg-gray-600 px-6 py-3 text-white transition-colors hover:bg-gray-700">
                            <i class="fa-solid fa-xmark mr-2"></i>
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Article? article;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticle();
    }

    private async Task LoadArticle()
    {
        isLoading = true;

        try
        {
            article = await ArticleService.GetArticleByIdAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading article: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            await ArticleService.UpdateArticleAsync(article);
            Navigation.NavigateTo("/inventory/articles");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}