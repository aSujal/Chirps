@attribute [Authorize]
@page "/inventory/transactions/create"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ArticleService ArticleService
@inject StockTransactionService StockTransactionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Create Stock Transaction</PageTitle>

<div class="p-6">
    <div class="mb-8 flex items-center">
        <a href="/inventory/transactions" class="mr-4 rounded-lg bg-gray-700 p-2 text-white transition-colors hover:bg-gray-600">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="text-3xl font-bold text-white">Create Stock Transaction</h1>
    </div>

    @if (isLoadingArticles)
    {
        <div class="flex h-64 items-center justify-center">
            <i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
        </div>
    }
    else
    {
        <div class="max-w-2xl">
            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <EditForm Model="@model" OnValidSubmit="@HandleSubmit" class="space-y-6">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="flex items-center rounded-lg border border-red-700 bg-red-900 px-4 py-3 text-red-300">
                            <i class="fa-solid fa-circle-exclamation mr-2"></i>
                            @errorMessage
                        </div>
                    }

                    <div>
                        <label for="articleId" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-box mr-1"></i>
                            Article
                        </label>
                        <InputSelect @bind-Value="model.ArticleId" 
                                     id="articleId"
                                     class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500">
                            <option value="0">Select an article...</option>
                            @foreach (var article in articles)
                            {
                                <option value="@article.Id">@article.ArticleNumber - @article.Name (Stock: @article.CurrentStock)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.ArticleId)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div>
                        <label for="type" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-arrow-right-arrow-left mr-1"></i>
                            Transaction Type
                        </label>
                        <InputSelect @bind-Value="model.Type" 
                                     id="type"
                                     class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500">
                            <option value="@TransactionType.StockIn">Stock In (Add inventory)</option>
                            <option value="@TransactionType.StockOut">Stock Out (Remove inventory)</option>
                            <option value="@TransactionType.Adjustment">Adjustment (Correct inventory)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => model.Type)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label for="quantity" class="mb-2 block text-sm font-medium text-gray-300">
                                <i class="fa-solid fa-hashtag mr-1"></i>
                                Quantity
                            </label>
                            <InputNumber @bind-Value="model.Quantity" 
                                         id="quantity"
                                         class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                         placeholder="Enter quantity" />
                            <ValidationMessage For="@(() => model.Quantity)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="unitPrice" class="mb-2 block text-sm font-medium text-gray-300">
                                <i class="fa-solid fa-dollar-sign mr-1"></i>
                                Unit Price
                            </label>
                            <InputNumber @bind-Value="model.UnitPrice" 
                                         id="unitPrice"
                                         class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                         placeholder="0.00" />
                            <ValidationMessage For="@(() => model.UnitPrice)" class="text-red-400 text-sm mt-1" />
                        </div>
                    </div>

                    <div>
                        <label for="date" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-calendar mr-1"></i>
                            Transaction Date
                        </label>
                        <InputDate @bind-Value="model.Date" 
                                   id="date"
                                   class="w-full rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500" />
                        <ValidationMessage For="@(() => model.Date)" class="text-red-400 text-sm mt-1" />
                    </div>

                    <div>
                        <label for="notes" class="mb-2 block text-sm font-medium text-gray-300">
                            <i class="fa-solid fa-note-sticky mr-1"></i>
                            Notes
                        </label>
                        <InputTextArea @bind-Value="model.Notes" 
                                       id="notes"
                                       rows="3"
                                       class="w-full resize-none rounded-lg border border-gray-600 bg-gray-900 px-4 py-3 text-white focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500"
                                       placeholder="Enter transaction notes (optional)" />
                        <ValidationMessage For="@(() => model.Notes)" class="text-red-400 text-sm mt-1" />
                    </div>

                    @if (model.Quantity > 0 && model.UnitPrice > 0)
                    {
                        <div class="rounded-lg border border-gray-600 bg-gray-900 p-4">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-300">Total Value:</span>
                                <span class="text-xl font-bold text-green-400">@model.TotalValue.ToString("C")</span>
                            </div>
                        </div>
                    }

                    <div class="flex gap-3 pt-4">
                        <button type="submit" 
                                disabled="@isSubmitting"
                                class="flex items-center rounded-lg bg-purple-600 px-6 py-3 text-white transition-colors hover:bg-purple-700 disabled:bg-gray-600">
                            @if (isSubmitting)
                            {
                                <i class="fa-solid fa-spinner fa-spin mr-2"></i>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-plus mr-2"></i>
                                <span>Create Transaction</span>
                            }
                        </button>
                        
                        <a href="/inventory/transactions" class="flex items-center rounded-lg bg-gray-600 px-6 py-3 text-white transition-colors hover:bg-gray-700">
                            <i class="fa-solid fa-xmark mr-2"></i>
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public int? ArticleId { get; set; }

    private StockTransaction model = new();
    private List<Article> articles = new();
    private bool isLoadingArticles = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
        
        if (ArticleId.HasValue)
        {
            model.ArticleId = ArticleId.Value;
        }
    }

    private async Task LoadArticles()
    {
        isLoadingArticles = true;
        
        try
        {
            articles = await ArticleService.GetAllArticlesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading articles: {ex.Message}";
        }
        finally
        {
            isLoadingArticles = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

  //       if(model.Type <= 0)
  //       {
  //           errorMessage = "Please select a valid Type.";
  //           isSubmitting = false;
  //           return;
		// }

        try
        {
            await StockTransactionService.CreateTransactionAsync(model);
            Navigation.NavigateTo("/inventory/transactions");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}