@* Components/Pages/Inventory/ArticleDetails.razor *@
@attribute [Authorize]
@page "/inventory/articles/{id:int}"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@inject ArticleService ArticleService
@inject StockTransactionService StockTransactionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Article Details</PageTitle>

<div class="p-6">
	<div class="mb-8 flex items-center justify-between">
		<div class="flex items-center">
			<a href="/inventory/articles" class="mr-4 rounded-lg bg-gray-700 p-2 text-white transition-colors hover:bg-gray-600">
				<i class="fa-solid fa-arrow-left"></i>
			</a>
			<h1 class="text-3xl font-bold text-white">Article Details</h1>
		</div>

		@if (article != null)
		{
			<div class="flex gap-3">
				<a href="/inventory/transactions/create?articleId=@article.Id" class="flex items-center rounded-lg bg-green-600 px-4 py-2 text-white transition-colors hover:bg-green-700">
					<i class="fa-solid fa-plus mr-2"></i> Add Transaction
				</a>
				<a href="/inventory/articles/@article.Id/edit" class="flex items-center rounded-lg bg-purple-600 px-4 py-2 text-white transition-colors hover:bg-purple-700">
					<i class="fa-solid fa-pen mr-2"></i> Edit
				</a>
				<button @onclick="DeleteArticle" class="flex items-center rounded-lg bg-red-600 px-4 py-2 text-white transition-colors hover:bg-red-700">
					<i class="fa-solid fa-trash mr-2"></i> Delete
				</button>
			</div>
		}
	</div>

	@if (isLoading)
	{
		<div class="flex h-64 items-center justify-center">
			<i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
		</div>
	}
	else if (article == null)
	{
		<div class="flex items-center rounded-lg border border-red-700 bg-red-900 px-4 py-3 text-red-300">
			<i class="fa-solid fa-circle-exclamation mr-2"></i>
			Article not found.
		</div>
	}
	else
	{
		<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
			<!-- Article Information -->
			<div class="lg:col-span-1">
				<div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
					<h2 class="mb-4 flex items-center text-xl font-semibold text-white">
						<i class="fa-solid fa-info-circle mr-2 text-blue-400"></i>
						Article Information
					</h2>

					<div class="space-y-4">
						<div>
							<label class="mb-1 block text-sm font-medium text-gray-400">Article Number</label>
							<p class="font-semibold text-white">@article.ArticleNumber</p>
						</div>

						<div>
							<label class="mb-1 block text-sm font-medium text-gray-400">Name</label>
							<p class="text-white">@article.Name</p>
						</div>

						<div>
							<label class="mb-1 block text-sm font-medium text-gray-400">Description</label>
							<p class="text-gray-300">@(string.IsNullOrEmpty(article.Description) ? "No description" : article.Description)</p>
						</div>

						<div>
							<label class="mb-1 block text-sm font-medium text-gray-400">Created</label>
							<p class="text-gray-300">@article.CreatedAt.ToString("MMM dd, yyyy")</p>
						</div>
					</div>
				</div>

				<!-- Stock Summary -->
				<div class="mt-6 rounded-lg border border-gray-700 bg-gray-800 p-6">
					<h2 class="mb-4 flex items-center text-xl font-semibold text-white">
						<i class="fa-solid fa-chart-pie mr-2 text-green-400"></i>
						Stock Summary
					</h2>

					<div class="grid grid-cols-1 gap-4">
						<div class="rounded-lg bg-gray-900 p-4">
							<div class="flex items-center justify-between">
								<span class="text-gray-400">Current Stock</span>
								<span class="text-2xl font-bold text-white">@article.CurrentStock</span>
							</div>
						</div>

						<div class="rounded-lg bg-gray-900 p-4">
							<div class="flex items-center justify-between">
								<span class="text-gray-400">Average Price</span>
								<span class="text-xl font-semibold text-green-400">@article.AveragePrice.ToString("C")</span>
							</div>
						</div>

						<div class="rounded-lg bg-gray-900 p-4">
							<div class="flex items-center justify-between">
								<span class="text-gray-400">Total Value</span>
								<span class="text-xl font-semibold text-blue-400">@article.TotalValue.ToString("C")</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Transaction History -->
			<div class="lg:col-span-2">
				<div class="rounded-lg border border-gray-700 bg-gray-800">
					<div class="border-b border-gray-700 px-6 py-4">
						<h2 class="flex items-center text-xl font-semibold text-white">
							<i class="fa-solid fa-clock-rotate-left mr-2 text-purple-400"></i>
							Transaction History
						</h2>
					</div>

					<div class="p-6">
						@if (isLoadingTransactions)
						{
							<div class="flex h-32 items-center justify-center">
								<i class="fa-solid fa-spinner fa-spin text-2xl text-purple-400"></i>
							</div>
						}
						else if (transactions.Any())
						{
							<div class="overflow-x-auto">
								<table class="w-full">
									<thead>
										<tr class="border-b border-gray-700">
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Date</th>
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Type</th>
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Quantity</th>
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Unit Price</th>
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Total</th>
											<th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Notes</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-gray-700">
										@foreach (var transaction in transactions)
										{
											<tr class="transition-colors hover:bg-gray-700">
												<td class="py-3 text-gray-300">@transaction.Date.ToString("MMM dd, yyyy")</td>
												<td class="py-3">
													<span class="rounded-full px-2 py-1 text-xs font-semibold @GetTransactionTypeClass(transaction.Type)">
														@GetTransactionTypeIcon(transaction.Type) @transaction.Type.ToString().Replace("Stock", "")
													</span>
												</td>
												<td class="py-3 text-gray-300">@transaction.Quantity</td>
												<td class="py-3 text-gray-300">@transaction.UnitPrice.ToString("C")</td>
												<td class="py-3 text-gray-300">@transaction.TotalValue.ToString("C")</td>
												<td class="py-3 text-gray-300">
													@if (!string.IsNullOrEmpty(transaction.Notes))
													{
														if (transaction.Notes.Length > 30)
														{
															<span title="@transaction.Notes">@transaction.Notes.Substring(0, 30)...</span>
														}
														else
														{
															@transaction.Notes
														}
													}
													else
													{
														<span class="text-gray-500">-</span>
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
						else
						{
							<div class="py-12 text-center">
								<i class="fa-solid fa-clock-rotate-left mb-4 text-4xl text-gray-500"></i>
								<h3 class="mb-2 text-lg font-semibold text-gray-300">No transactions yet</h3>
								<p class="mb-6 text-gray-400">Start by adding your first stock transaction.</p>
								<a href="/inventory/transactions/create?articleId=@article.Id" class="inline-flex items-center rounded-lg bg-purple-600 px-6 py-3 text-white transition-colors hover:bg-purple-700">
									<i class="fa-solid fa-plus mr-2"></i> Add Transaction
								</a>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
</div>

@code {
	[Parameter] public int Id { get; set; }

	private Article? article;
	private List<StockTransaction> transactions = new();
	private bool isLoading = true;
	private bool isLoadingTransactions = true;

	protected override async Task OnInitializedAsync()
	{
		await LoadArticle();
		await LoadTransactions();
	}

	private async Task LoadArticle()
	{
		isLoading = true;

		try
		{
			article = await ArticleService.GetArticleByIdAsync(Id);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading article: {ex.Message}");
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task LoadTransactions()
	{
		isLoadingTransactions = true;

		try
		{
			transactions = await StockTransactionService.GetTransactionsByArticleAsync(Id);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading transactions: {ex.Message}");
		}
		finally
		{
			isLoadingTransactions = false;
		}
	}

	private async Task DeleteArticle()
	{
		if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this article? This action cannot be undone."))
		{
			try
			{
				await ArticleService.DeleteArticleAsync(Id);
				Navigation.NavigateTo("/inventory/articles");
			}
			catch (Exception ex)
			{
				await JSRuntime.InvokeVoidAsync("alert", $"Error deleting article: {ex.Message}");
			}
		}
	}

	private string GetTransactionTypeClass(TransactionType type)
	{
		return type switch
		{
			TransactionType.StockIn => "bg-green-600 text-white",
			TransactionType.StockOut => "bg-red-600 text-white",
			TransactionType.Adjustment => "bg-blue-600 text-white",
			_ => "bg-gray-600 text-white"
		};
	}

	private string GetTransactionTypeIcon(TransactionType type)
	{
		return type switch
		{
			TransactionType.StockIn => "↗",
			TransactionType.StockOut => "↘",
			TransactionType.Adjustment => "⚡",
			_ => "•"
		};
	}
}