@* Components/Pages/Inventory/Articles.razor *@
@attribute [Authorize]
@page "/inventory/articles"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@inject ArticleService ArticleService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Articles</PageTitle>

<div class="p-6">
	<div class="mb-8 flex items-center justify-between">
		<h1 class="text-3xl font-bold text-white">Articles</h1>
		<a href="/inventory/articles/create" class="flex items-center rounded-lg bg-purple-600 px-4 py-2 text-white transition-colors hover:bg-purple-700">
			<i class="fa-solid fa-plus mr-2"></i> Add New Article
		</a>
	</div>

	<!-- Search Bar -->
	<div class="mb-6">
		<div class="flex max-w-md gap-3">
			<input type="text"
				   class="flex-1 rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-purple-500"
				   placeholder="Search articles..."
				   @bind="searchTerm"
				   @onkeypress="OnSearchKeyPress">
			<button class="rounded-lg bg-gray-700 px-4 py-2 text-white transition-colors hover:bg-gray-600" @onclick="SearchArticles">
				<i class="fa-solid fa-magnifying-glass"></i>
			</button>
		</div>
	</div>

	@if (isLoading)
	{
		<div class="flex h-64 items-center justify-center">
			<i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
		</div>
	}
	else if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="mb-6 flex items-center rounded-lg border border-red-700 bg-red-900 px-4 py-3 text-red-300">
			<i class="fa-solid fa-circle-exclamation mr-2"></i>
			@errorMessage
		</div>
	}
	else
	{
		<div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800">
			@if (articles.Any())
			{
				<div class="overflow-x-auto">
					<table class="w-full">
						<thead class="bg-gray-900">
							<tr>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Article Number</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Name</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Description</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Stock</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Avg. Price</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Total Value</th>
								<th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-700">
							@foreach (var article in articles)
							{
								<tr class="transition-colors hover:bg-gray-700">
									<td class="whitespace-nowrap px-6 py-4">
										<span class="font-semibold text-white">@article.ArticleNumber</span>
									</td>
									<td class="whitespace-nowrap px-6 py-4 text-gray-300">@article.Name</td>
									<td class="px-6 py-4 text-gray-300">
										@if (article.Description.Length > 50)
										{
											<span title="@article.Description">
												@article.Description.Substring(0, 50)...
											</span>
										}
										else
										{
											@article.Description
										}
									</td>
									<td class="whitespace-nowrap px-6 py-4">
										<span class="rounded-full px-2 py-1 text-xs font-semibold @(article.CurrentStock <= 10 ? "bg-yellow-600 text-white" : "bg-green-600 text-white")">
											@article.CurrentStock
										</span>
									</td>
									<td class="whitespace-nowrap px-6 py-4 text-gray-300">@article.AveragePrice.ToString("C")</td>
									<td class="whitespace-nowrap px-6 py-4 text-gray-300">@article.TotalValue.ToString("C")</td>
									<td class="whitespace-nowrap px-6 py-4">
										<div class="flex gap-2">
											<a href="/inventory/articles/@article.Id" class="rounded bg-blue-600 p-2 text-white transition-colors hover:bg-blue-700" title="View">
												<i class="fa-solid fa-eye"></i>
											</a>
											<a href="/inventory/articles/@article.Id/edit" class="rounded bg-purple-600 p-2 text-white transition-colors hover:bg-purple-700" title="Edit">
												<i class="fa-solid fa-pen"></i>
											</a>
											<button class="rounded bg-red-600 p-2 text-white transition-colors hover:bg-red-700" @onclick="() => DeleteArticle(article.Id)" title="Delete">
												<i class="fa-solid fa-trash"></i>
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="py-16 text-center">
					<i class="fa-solid fa-boxes-stacked mb-4 text-6xl text-gray-500"></i>
					<h3 class="mb-2 text-xl font-semibold text-gray-300">No articles found</h3>
					<p class="mb-6 text-gray-400">Start by adding your first article to the inventory.</p>
					<a href="/inventory/articles/create" class="inline-flex items-center rounded-lg bg-purple-600 px-6 py-3 text-white transition-colors hover:bg-purple-700">
						<i class="fa-solid fa-plus mr-2"></i> Add First Article
					</a>
				</div>
			}
		</div>
	}
</div>

@code {
	private List<Article> articles = new();
	private bool isLoading = true;
	private string? errorMessage;
	private string searchTerm = "";

	protected override async Task OnInitializedAsync()
	{
		await LoadArticles();
	}

	private async Task LoadArticles()
	{
		isLoading = true;
		errorMessage = null;

		try
		{
			articles = await ArticleService.GetAllArticlesAsync();
		}
		catch (Exception ex)
		{
			errorMessage = $"Error loading articles: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task SearchArticles()
	{
		isLoading = true;
		errorMessage = null;

		try
		{
			articles = await ArticleService.SearchArticlesAsync(searchTerm);
		}
		catch (Exception ex)
		{
			errorMessage = $"Error searching articles: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task OnSearchKeyPress(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			await SearchArticles();
		}
	}

	private async Task DeleteArticle(int id)
	{
		if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this article?"))
		{
			try
			{
				await ArticleService.DeleteArticleAsync(id);
				await LoadArticles();
			}
			catch (Exception ex)
			{
				errorMessage = $"Error deleting article: {ex.Message}";
			}
		}
	}
}