@attribute [Authorize]
@page "/inventory/dashboard"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@inject ArticleService ArticleService
@inject StockTransactionService StockTransactionService
@rendermode InteractiveServer

<PageTitle>Inventory Dashboard</PageTitle>

<div class="p-6">
    <div class="mb-8 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-white">Inventory Dashboard</h1>
        <div class="flex gap-3">
            <a href="/inventory/articles/create" class="flex items-center rounded-lg bg-purple-600 px-4 py-2 text-white transition-colors hover:bg-purple-700">
                <i class="fa-solid fa-plus mr-2"></i> Add Article
            </a>
            <a href="/inventory/transactions/create" class="flex items-center rounded-lg bg-green-600 px-4 py-2 text-white transition-colors hover:bg-green-700">
                <i class="fa-solid fa-arrow-right-arrow-left mr-2"></i> New Transaction
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex h-64 items-center justify-center">
            <i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Articles</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalArticles</p>
                    </div>
                    <div class="rounded-lg bg-purple-600 p-3">
                        <i class="fa-solid fa-boxes-stacked text-xl text-white"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Stock</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalStockQuantity</p>
                    </div>
                    <div class="rounded-lg bg-green-600 p-3">
                        <i class="fa-solid fa-warehouse text-xl text-white"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Value</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalInventoryValue.ToString("C")</p>
                    </div>
                    <div class="rounded-lg bg-blue-600 p-3">
                        <i class="fa-solid fa-dollar-sign text-xl text-white"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Low Stock</p>
                        <p class="mt-2 text-3xl font-bold text-white">@lowStockArticles.Count</p>
                    </div>
                    <div class="rounded-lg bg-yellow-600 p-3">
                        <i class="fa-solid fa-triangle-exclamation text-xl text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Top Value Articles -->
            <div class="rounded-lg border border-gray-700 bg-gray-800">
                <div class="border-b border-gray-700 px-6 py-4">
                    <h3 class="flex items-center text-lg font-semibold text-white">
                        <i class="fa-solid fa-trophy mr-2 text-yellow-400"></i>
                        Top Value Articles
                    </h3>
                </div>
                <div class="p-6">
                    @if (topValueArticles.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var article in topValueArticles)
                            {
                                <div class="flex items-center justify-between rounded-lg bg-gray-900 p-4">
                                    <div>
                                        <p class="font-semibold text-white">@article.ArticleNumber</p>
                                        <p class="text-sm text-gray-400">@article.Name</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-gray-400">Stock: @article.CurrentStock</p>
                                        <p class="font-semibold text-green-400">@article.TotalValue.ToString("C")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="py-8 text-center">
                            <i class="fa-solid fa-box-open mb-3 text-3xl text-gray-500"></i>
                            <p class="text-gray-400">No articles found.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Low Stock Articles -->
            <div class="rounded-lg border border-gray-700 bg-gray-800">
                <div class="border-b border-gray-700 px-6 py-4">
                    <h3 class="flex items-center text-lg font-semibold text-white">
                        <i class="fa-solid fa-triangle-exclamation mr-2 text-yellow-400"></i>
                        Low Stock Alert
                    </h3>
                </div>
                <div class="p-6">
                    @if (lowStockArticles.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var article in lowStockArticles)
                            {
                                <div class="flex items-center justify-between rounded-lg bg-gray-900 p-4">
                                    <div>
                                        <p class="font-semibold text-white">@article.ArticleNumber</p>
                                        <p class="text-sm text-gray-400">@article.Name</p>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="rounded bg-yellow-600 px-2 py-1 text-sm text-white">@article.CurrentStock</span>
                                        <a href="/inventory/transactions/create?articleId=@article.Id" class="rounded bg-purple-600 px-3 py-1 text-sm text-white transition-colors hover:bg-purple-700">
                                            Restock
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="py-8 text-center">
                            <i class="fa-solid fa-circle-check mb-3 text-3xl text-green-400"></i>
                            <p class="text-green-400">All articles have sufficient stock.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int totalArticles = 0;
    private int totalStockQuantity = 0;
    private decimal totalInventoryValue = 0;
    private List<Article> topValueArticles = new();
    private List<Article> lowStockArticles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        
        try
        {
            totalArticles = await StockTransactionService.GetTotalArticleCountAsync();
            totalStockQuantity = await StockTransactionService.GetTotalStockQuantityAsync();
            totalInventoryValue = await StockTransactionService.GetTotalInventoryValueAsync();
            topValueArticles = await ArticleService.GetTopValueArticlesAsync(3);
            lowStockArticles = await ArticleService.GetLowStockArticlesAsync(10);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}