@* Components/Pages/Inventory/Reports.razor *@
@attribute [Authorize]
@page "/inventory/reports"
@using ExampleBlazor.Services
@using ExampleBlazor.Models
@using Microsoft.AspNetCore.Authorization
@inject ArticleService ArticleService
@inject StockTransactionService StockTransactionService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Inventory Reports</PageTitle>

<div class="p-6">
    <div class="mb-8 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-white">Inventory Reports</h1>
        <button @onclick="ExportReport" class="flex items-center rounded-lg bg-green-600 px-4 py-2 text-white transition-colors hover:bg-green-700">
            <i class="fa-solid fa-download mr-2"></i> Export Report
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex h-64 items-center justify-center">
            <i class="fa-solid fa-spinner fa-spin text-4xl text-purple-400"></i>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Articles</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalArticles</p>
                    </div>
                    <div class="rounded-lg bg-purple-600 p-3">
                        <i class="fa-solid fa-boxes-stacked text-xl text-white"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Stock Units</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalStockQuantity</p>
                    </div>
                    <div class="rounded-lg bg-green-600 p-3">
                        <i class="fa-solid fa-warehouse text-xl text-white"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border border-gray-700 bg-gray-800 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-gray-400">Total Inventory Value</p>
                        <p class="mt-2 text-3xl font-bold text-white">@totalInventoryValue.ToString("C")</p>
                    </div>
                    <div class="rounded-lg bg-blue-600 p-3">
                        <i class="fa-solid fa-dollar-sign text-xl text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Stock Report -->
        <div class="mb-6 rounded-lg border border-gray-700 bg-gray-800">
            <div class="border-b border-gray-700 px-6 py-4">
                <h2 class="flex items-center text-xl font-semibold text-white">
                    <i class="fa-solid fa-clipboard-list mr-2 text-blue-400"></i>
                    Current Stock Report
                </h2>
            </div>
            <div class="p-6">
                @if (articles.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-gray-700">
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Article Number</th>
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Name</th>
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Current Stock</th>
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Avg. Price</th>
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Total Value</th>
                                    <th class="py-3 text-left text-sm font-medium uppercase tracking-wider text-gray-400">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-700">
                                @foreach (var article in articles.OrderByDescending(a => a.TotalValue))
                                {
                                    <tr class="transition-colors hover:bg-gray-700">
                                        <td class="py-3 font-semibold text-white">@article.ArticleNumber</td>
                                        <td class="py-3 text-gray-300">@article.Name</td>
                                        <td class="py-3 text-gray-300">@article.CurrentStock</td>
                                        <td class="py-3 text-gray-300">@article.AveragePrice.ToString("C")</td>
                                        <td class="py-3 text-gray-300">@article.TotalValue.ToString("C")</td>
                                        <td class="py-3">
                                            @if (article.CurrentStock <= 0)
                                            {
                                                <span class="rounded-full bg-red-600 px-2 py-1 text-xs font-semibold text-white">
                                                    <i class="fa-solid fa-circle-xmark mr-1"></i>Out of Stock
                                                </span>
                                            }
                                            else if (article.CurrentStock <= 10)
                                            {
                                                <span class="rounded-full bg-yellow-600 px-2 py-1 text-xs font-semibold text-white">
                                                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>Low Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="rounded-full bg-green-600 px-2 py-1 text-xs font-semibold text-white">
                                                    <i class="fa-solid fa-circle-check mr-1"></i>In Stock
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="py-8 text-center">
                        <i class="fa-solid fa-clipboard-list mb-4 text-4xl text-gray-500"></i>
                        <p class="text-gray-400">No articles to display in the report.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Top Value Articles -->
        <div class="rounded-lg border border-gray-700 bg-gray-800">
            <div class="border-b border-gray-700 px-6 py-4">
                <h2 class="flex items-center text-xl font-semibold text-white">
                    <i class="fa-solid fa-trophy mr-2 text-yellow-400"></i>
                    Top 10 Articles by Value
                </h2>
            </div>
            <div class="p-6">
                @if (topValueArticles.Any())
                {
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var (article, index) in topValueArticles.Select((a, i) => (a, i)))
                        {
                            <div class="rounded-lg border border-gray-600 bg-gray-900 p-4">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="text-sm font-medium text-gray-400">#@(index + 1)</span>
                                    @if (index < 3)
                                    {
                                        <i class="fa-solid fa-medal text-yellow-400"></i>
                                    }
                                </div>
                                <h3 class="mb-1 font-semibold text-white">@article.ArticleNumber</h3>
                                <p class="mb-2 text-sm text-gray-400">@article.Name</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400">Stock: @article.CurrentStock</span>
                                    <span class="font-semibold text-green-400">@article.TotalValue.ToString("C")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-8 text-center">
                        <i class="fa-solid fa-trophy mb-4 text-4xl text-gray-500"></i>
                                               <p class="text-gray-400">No articles available for ranking.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Article> articles = new();
    private List<Article> topValueArticles = new();
    private bool isLoading = true;
    private int totalArticles = 0;
    private int totalStockQuantity = 0;
    private decimal totalInventoryValue = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private async Task LoadReportData()
    {
        isLoading = true;
        
        try
        {
            articles = await ArticleService.GetAllArticlesAsync();
            topValueArticles = await ArticleService.GetTopValueArticlesAsync(10);
            totalArticles = await StockTransactionService.GetTotalArticleCountAsync();
            totalStockQuantity = await StockTransactionService.GetTotalStockQuantityAsync();
            totalInventoryValue = await StockTransactionService.GetTotalInventoryValueAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportReport()
    {
        try
        {
            var reportData = new
            {
                GeneratedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                Summary = new
                {
                    TotalArticles = totalArticles,
                    TotalStockQuantity = totalStockQuantity,
                    TotalInventoryValue = totalInventoryValue
                },
                Articles = articles.Select(a => new
                {
                    a.ArticleNumber,
                    a.Name,
                    a.Description,
                    CurrentStock = a.CurrentStock,
                    AveragePrice = a.AveragePrice,
                    TotalValue = a.TotalValue,
                    Status = a.CurrentStock <= 0 ? "Out of Stock" : 
                            a.CurrentStock <= 10 ? "Low Stock" : "In Stock"
                }).OrderByDescending(a => a.TotalValue)
            };

            var json = System.Text.Json.JsonSerializer.Serialize(reportData, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true 
            });

            await JSRuntime.InvokeVoidAsync("downloadFile", "inventory-report.json", json, "application/json");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error exporting report: {ex.Message}");
        }
    }
}