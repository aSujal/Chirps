@using ExampleBlazor.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
<AuthorizeView>
	<Authorized>
		<div class="relative min-h-screen w-64 border-r border-gray-900 bg-gray-900/50 shadow-md">
			<div class="border-b border-gray-800 p-6">
				<h1 class="text-2xl font-bold text-white">
					<span class="bg-gradient-to-r">
						ExampleBlazor
					</span>
				</h1>
			</div>
			<!-- User Info -->
			<div class="border-b border-gray-800 p-4">
				<div class="flex items-center space-x-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-r from-purple-500 to-pink-500">
						<i class="fa-solid fa-user text-sm text-white"></i>
					</div>
					<div>
						<p class="font-medium text-white">@context.User.Identity?.Name</p>
					</div>
				</div>
			</div>

			<!-- Navigation Links -->
			<nav class="mt-3 flex flex-col gap-3">
				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="" Match="NavLinkMatch.All">
					<i class="fa-solid fa-home"></i>
					<span>Home</span>
				</NavLink>
				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="/inventory/dashboard">
					<i class="fa-solid fa-tachometer-alt"></i>
					<span>Dashboard</span>
				</NavLink>

				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="/inventory/articles">
					<i class="fa-solid fa-boxes"></i>
					<span>Articles</span>
				</NavLink>

				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="/inventory/transactions">
					<i class="fa-solid fa-exchange-alt"></i>
					<span>Stock Transactions</span>
				</NavLink>

				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="/inventory/reports">
					<i class="fas fa-chart-bar"></i>
					<span>Reports</span>
				</NavLink>
				@* 
				<NavLink class="nav-link-custom p-3 text-white transition-colors hover:bg-purple-500/40" href="counter">
					<i class="fa-solid fa-calculator"></i>
					<span>Counter</span>
				</NavLink> *@

			</nav>

			<!-- Logout Button -->
			<div class="absolute bottom-6 left-4 right-4">
				<button @onclick="@HandleLogout"
						class="group flex w-full items-center space-x-3 rounded-lg bg-gray-800/50 px-4 py-3 text-gray-300 transition-all duration-200 hover:bg-red-600 hover:text-white">
					<i class="fa-solid fa-sign-out-alt group-hover:text-white"></i>
					<span>Logout</span>
				</button>
			</div>
		</div>
	</Authorized>
</AuthorizeView>

@code {
	[Inject]
	private NavigationManager Navigation { get; set; } = default!;
	[Inject]
	private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

	private void HandleLogout()
	{
		NavigationManager.NavigateTo("/logout", true);
	}

	private string GetPageTitle()
	{
		var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);

		return currentPath switch
		{
			"" => "Dashboard",
			"counter" => "Counter",
			"weather" => "Weather Forecast",
			_ => "Page"
		};
	}
}