@using Chirps.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@rendermode InteractiveServer


<div class="relative min-h-screen w-16 sm:w-64 border-r border-gray-900 bg-gray-900/50 shadow-md transition-all duration-300">
	<!-- Header -->
	<div class="border-b border-gray-800 p-3 sm:p-6">
		<h1 class="text-2xl font-bold text-white flex items-center justify-center sm:justify-start">
			<i class="fa-solid fa-dove text-purple-500"></i>
			<span class="hidden sm:inline ml-2">Chirps</span>
		</h1>
	</div>

	<AuthorizeView>
		<Authorized>
			<!-- User Info -->
			<div class="border-b border-gray-800 p-3 sm:p-4">
				<div class="flex items-center justify-center sm:justify-start sm:space-x-3">
					<a href="/profile/@context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" class="flex items-center">
						@* class="flex items-center space-x-3 text-gray-300 hover:text-white transition-colors"> *@
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-r from-purple-500 to-pink-500">
							<span class="text-sm font-bold text-white">
								@context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper()
							</span>
						</div>
						<span class="hidden sm:inline text-gray-300 ml-2">
							@context.User.Identity?.Name
						</span>
					</a>
				</div>
			</div>

			<!-- Navigation Links -->
			<nav class="mt-3 flex flex-col gap-1 px-2 sm:px-3">
				<NavLink class="nav-link-custom flex items-center justify-center sm:justify-start rounded-lg p-3 text-gray-300 transition-all hover:bg-purple-500/20 hover:text-white"
						 href=""
						 Match="NavLinkMatch.All">
					<i class="fa-solid fa-home text-lg"></i>
					<span class="hidden sm:inline ml-3">Home</span>
				</NavLink>

				<NavLink class="nav-link-custom flex items-center justify-center sm:justify-start rounded-lg p-3 text-gray-300 transition-all hover:bg-purple-500/20 hover:text-white"
						 href="@($"/profile/{context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value}")">
					<i class="fa-solid fa-user text-lg"></i>
					<span class="hidden sm:inline ml-3">My Profile</span>
				</NavLink>

				<NavLink class="nav-link-custom flex items-center justify-center sm:justify-start rounded-lg p-3 text-gray-300 transition-all hover:bg-purple-500/20 hover:text-white"
						 href="/search">
					<i class="fa-solid fa-search text-lg"></i>
					<span class="hidden sm:inline ml-3">Search</span>
				</NavLink>
			</nav>
		</Authorized>

		<NotAuthorized>
			<!-- Guest Navigation -->
			<nav class="mt-3 flex flex-col gap-1 px-2 sm:px-3">
				<NavLink class="nav-link-custom flex items-center justify-center sm:justify-start rounded-lg p-3 text-gray-300 transition-all hover:bg-purple-500/20 hover:text-white"
						 href=""
						 Match="NavLinkMatch.All">
					<i class="fa-solid fa-home text-lg"></i>
					<span class="hidden sm:inline ml-3">Home</span>
				</NavLink>

				<NavLink class="nav-link-custom flex items-center justify-center sm:justify-start rounded-lg p-3 text-gray-300 transition-all hover:bg-purple-500/20 hover:text-white"
						 href="/search">
					<i class="fa-solid fa-search text-lg"></i>
					<span class="hidden sm:inline ml-3">Search</span>
				</NavLink>
			</nav>

			<!-- Call to Action -->
			<div class="mt-6 border-t border-gray-800 p-2 sm:p-4">
				<div class="space-y-2">
					<NavLink href="/login"
							 class="flex items-center justify-center rounded-lg bg-purple-600 p-2 text-white transition-colors hover:bg-purple-700">
						<i class="fa-solid fa-sign-in-alt text-lg"></i>
						<span class="hidden sm:inline ml-2 text-sm font-medium">Sign In</span>
					</NavLink>
					<NavLink href="/register"
							 class="flex items-center justify-center rounded-lg border border-purple-600 p-2 text-purple-400 transition-colors hover:bg-purple-600 hover:text-white">
						<i class="fa-solid fa-user-plus text-lg"></i>
						<span class="hidden sm:inline ml-2 text-sm font-medium">Sign Up</span>
					</NavLink>
				</div>
			</div>
		</NotAuthorized>
	</AuthorizeView>

	<AuthorizeView>
		<Authorized>
			<!-- Logout Button -->
			<div class="absolute bottom-6 left-2 right-2 sm:left-4 sm:right-4">
				<button @onclick="@HandleLogout"
						class="group flex w-full items-center justify-center rounded-lg bg-gray-800/50 p-3 text-gray-300 transition-all duration-200 hover:bg-red-600/20 hover:text-red-400">
					<i class="fa-solid fa-sign-out-alt"></i>
					<span class="hidden sm:inline ml-3">Logout</span>
				</button>
			</div>
		</Authorized>
	</AuthorizeView>
</div>

@code {
	private void HandleLogout()
	{
		NavigationManager.NavigateTo("/logout", true);
	}
}